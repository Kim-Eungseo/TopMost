\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Active-Unit regularizer ablation on 20NG ($K=50$). AU = 0 at all weights; the regularizer modestly affects NPMI but cannot resolve the structural collapse.}}{13}{}\protected@file@percent }
\newlabel{tab:au_ablation}{{10}{13}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Empirical Amortization Gap: Why Langevin Fails on IMDb}{13}{}\protected@file@percent }
\newlabel{sec:amort_gap_empirical}{{6.3}{13}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Empirical amortization gap: how much Langevin refinement helps the encoder. $\Delta $L2: mean Euclidean distance $\|z_L - z_0\|$ (step size). $\Delta $logLik: mean log-likelihood improvement $\log p(x|z_L) - \log p(x|z_0)$ (benefit). IMDb shows the same step size but $10\times $ smaller benefit, confirming its encoder already approximates the posterior well.}}{13}{}\protected@file@percent }
\newlabel{tab:amort_gap}{{11}{13}{}{}{}}
